# Copiar a ".env" y rellenar. El archivo .env NO se comparte ni se sube a git.

# Obligatorio: la SEC exige un User-Agent con un contacto real.
SEC_USER_AGENT=RadarAcciones/1.0 tu_email@dominio.com

# Opcional: avisos por Telegram.
# Token: lo da @BotFather al crear el bot (/newbot).
TELEGRAM_BOT_TOKEN=
# chat_id: escribe un mensaje a tu bot y ejecuta `python -m radar telegram-setup`.
TELEGRAM_CHAT_ID=
